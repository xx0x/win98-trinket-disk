



; 1394.INF  -- This file contains descriptions of all the 1394
;              Host controllers supported in Windows 98/NT
;
;*** Created 11/2/96  (Creation Date)

[Version]
CatalogFile=1394.cat
LayoutFile=Layout.inf, Layout1.inf, Layout2.inf
signature="$CHICAGO$"
Class=1394
ClassGUID={6BDD1FC1-810F-11D0-BEC7-08002BE2092F}
Provider=%Msft%

[DestinationDirs]
DefaultDestDir=11               ; LDID_SYS
TILynx.CopyFiles=10,system32\drivers
Adaptec.CopyFiles=10,system32\drivers
OHCI.CopyFiles=10,system32\drivers
1394.CopyFiles=10,system32\drivers
NTMAPHLP.CopyFiles=12
1394.DelFiles=10,system32\drivers
1394Inf.DelFiles=17

; =================== Class Sections ===========================

[ClassInstall]
Addreg=1394ClassReg

[1394ClassReg]
HKR,,,,%1394ClassName%
HKR,,Icon,,-21

; =================== Table of content =========================

[Manufacturer]
%Generic.Mfg%=Generic.Section
%AdaptecMfg%=Adaptec
%IntelMFG%=Intel
%NECMfg%=NEC
%NSCMfg%=NSC
%SISMFG%=SIS
%SONYMFG%=SONY
%TIMfg%=TI


; =================== Adaptec ========================

[Adaptec]
%PCI\VEN_9004&DEV_5800.DeviceDesc%=Adaptec.Device,,PCI\VEN_9004&DEV_5800
%PCI\VEN_9004&DEV_5800&SUBSYS_89409004.DeviceDesc%=Adaptec.Device,,PCI\VEN_9004&DEV_5800&SUBSYS_89409004
%PCI\VEN_9004&DEV_5800&SUBSYS_89419004.DeviceDesc%=Adaptec.Device,,PCI\VEN_9004&DEV_5800&SUBSYS_89419004
%PCI\VEN_9004&DEV_5800&SUBSYS_89459004.DeviceDesc%=Adaptec.Device,,PCI\VEN_9004&DEV_5800&SUBSYS_89459004
%PCI\VEN_9004&DEV_5800&SUBSYS_89469004.DeviceDesc%=Adaptec.Device,,PCI\VEN_9004&DEV_5800&SUBSYS_89469004
%PCI\VEN_9004&DEV_5800&SUBSYS_89439004.DeviceDesc%=Adaptec.Device,,PCI\VEN_9004&DEV_5800&SUBSYS_89439004

[Adaptec.Device]
AddReg=Adaptec.AddReg, 1394.AddReg
CopyFiles=Adaptec.CopyFiles, 1394.CopyFiles, NTMAPHLP.CopyFiles

[Adaptec.AddReg]
HKR,,NTMPDriver,,aha894x.sys
HKR,,PreloadDrivers,,"aha894x.sys,"%1394PreloadDrivers%

[Adaptec.CopyFiles]
aha894x.sys

; ===================== INTEL ===============================

[Intel]
%PCI\VEN_8086&DEV_7605.DeviceDesc%=OHCI.Device,PCI\VEN_8086&DEV_7605

; ===================== NEC ===============================

[NEC]
%PCI\VEN_1033&DEV_0063.DeviceDesc%=OHCI.Device,PCI\VEN_1033&DEV_0063
%PCI\VEN_1033&CC_0C0010.DeviceDesc%=OHCI.Device,PCI\VEN_1033&CC_0C0010

; ===================== NSC ===============================

[NSC]
%PCI\VEN_100B&DEV_000F.DeviceDesc%=OHCI.Device,PCI\VEN_100B&DEV_000F
%PCI\VEN_100B&CC_0C0010.DeviceDesc%=OHCI.Device,PCI\VEN_100B&CC_0C0010

; ===================== SIS ===============================

[SIS]
%PCI\VEN_1039&DEV_7007.DeviceDesc%=OHCI.Device,PCI\VEN_1039&DEV_7007

; ===================== Sony ===============================

[SONY]
%PCI\VEN_104D&DEV_8039.DeviceDesc%=SONY8039.Device,PCI\VEN_104D&DEV_8039
%PCI\VEN_104D&DEV_8039&REV_03.DeviceDesc%=SONY8039REV3.Device,PCI\VEN_104D&DEV_8039&REV_03


[SONY8039.Device]
AddReg=OHCI.AddReg, 1394.AddReg
CopyFiles=OHCI.CopyFiles, 1394.CopyFiles

[SONY8039.Device.HW]
AddReg=SONY8039.AddReg.HW

[SONY8039.AddReg.HW]
HKR,,DiagnosticMode,0x00010003,2

[SONY8039REV3.Device]
AddReg=OHCI.AddReg, 1394.AddReg
CopyFiles=OHCI.CopyFiles, 1394.CopyFiles


; =================== Texas Instruments ========================

[TI]
%PCI\VEN_104C&DEV_8000.DeviceDesc%=TILynx.Device,PCI\VEN_104C&DEV_8000
%PCI\VEN_104C&DEV_8000&SUBSYS_8003104C.DeviceDesc%=TILynx.Device,PCI\VEN_104C&DEV_8000&SUBSYS_8003104C
%PCI\VEN_104C&DEV_8009.DeviceDesc%=OHCI.Device,PCI\VEN_104C&DEV_8009
%PCI\VEN_104C&DEV_8009&SUBSYS_800D104C.DeviceDesc%=OHCI.Device,PCI\VEN_104C&DEV_8009&SUBSYS_800D104C
%PCI\VEN_104C&CC_0C0010.DeviceDesc%=OHCI.Device,PCI\VEN_104C&CC_0C0010

%PCI\VEN_104C&DEV_8009&SUBSYS_B11F0E11.DeviceDesc%=CompaqDV.Device,,PCI\VEN_104C&DEV_8009&SUBSYS_B11F0E11
%PCI\VEN_104C&DEV_8019&SUBSYS_B11F0E11.DeviceDesc%=CompaqDV.Device,,PCI\VEN_104C&DEV_8019&SUBSYS_B11F0E11
%PCI\VEN_9004&DEV_5800&SUBSYS_B0CB0E11.DeviceDesc%=CompaqDV.Device,,PCI\VEN_9004&DEV_5800&SUBSYS_B0CB0E11

%PCI\VEN_104C&DEV_8009&SUBSYS_8032104D.DeviceDesc%=OHCI.Device,PCI\VEN_104C&DEV_8009&SUBSYS_8032104D

[CompaqDV.Device]
; this is empty for a reason

[TILynx.Device]
AddReg=TILynx.AddReg, 1394.AddReg
CopyFiles=TILynx.CopyFiles, 1394.CopyFiles, NTMAPHLP.CopyFiles

[TILynx.AddReg]
HKR,,NTMPDriver,,tilynx.sys
HKR,,PreloadDrivers,,"tilynx.sys,"%1394PreloadDrivers%

[TILynx.CopyFiles]
tilynx.sys

; =================== Generic ==================================

[Generic.Section]
%PCI\CC_0C0010.DeviceDesc%=OHCI.Device,PCI\CC_0C0010

[1394.AddReg]
HKR,,DevLoader,,*NTKERN
HKR,,EnumPropPages,,"sysclass.dll,Bus1394EnumPropPages"

[1394.CopyFiles]
1394bus.sys
sbp2port.sys
ntmap.sys
dbfilter.sys
dbclass.sys

[1394.DelFiles]
sonyohci.sys,,,1

[1394Inf.DelFiles]
sonyohci.inf,,,1

[NTMAPHLP.CopyFiles]
ntmaphlp.pdr

[OHCI.Device]
AddReg=OHCI.AddReg, 1394.AddReg
CopyFiles=OHCI.CopyFiles, 1394.CopyFiles, NTMAPHLP.CopyFiles
DelFiles=1394.DelFiles, 1394Inf.DelFiles

[OHCI.AddReg]
HKR,,NTMPDriver,,ohci1394.sys
HKR,,PreloadDrivers,,"ohci1394.sys,"%1394PreloadDrivers%

[OHCI.CopyFiles]
ohci1394.sys

[ControlFlags]

