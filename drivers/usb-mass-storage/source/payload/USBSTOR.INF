[USBSTOR_CBI_U2A]
;CopyFiles=USBSTOR.CopyList, USBNTMAP.CopyList, USBU2A.CopyList
AddReg=USBSTOR.AddReg, USBSTOR_CBI.AddReg
DriverVer=06/08/2000

[USBSTOR_CBI]
;CopyFiles=USBSTOR.CopyList, USBNTMAP.CopyList
AddReg=USBSTOR.AddReg, USBSTOR_CBI.AddReg
DriverVer=06/08/2000

[USBSTOR_CBI_NR]
;CopyFiles=USBSTOR.CopyList, USBNTMAP.CopyList
AddReg=USBSTOR.AddReg, USBSTOR_CBI.AddReg, USBSTOR_NR.AddReg
DelReg=USBSTOR_CBI_NR.DelReg
DriverVer=06/08/2000

[USBSTOR_CB]
;CopyFiles=USBSTOR.CopyList, USBNTMAP.CopyList
AddReg=USBSTOR.AddReg, USBSTOR_CB.AddReg
DriverVer=06/08/2000

[USBSTOR_BULK]
;CopyFiles=USBSTOR.CopyList, USBNTMAP.CopyList
AddReg=USBSTOR.AddReg, USBSTOR_BULK.AddReg
DriverVer=06/08/2000

[USBSTOR_BULK_AUTH]
;CopyFiles=USBSTOR.CopyList, USBNTMAP.CopyList, USBAUTH.CopyList
AddReg=USBSTOR.AddReg, USBSTOR_BULK.AddReg
DriverVer=06/08/2000

[USBSTOR_BULKNO]

[USBSTOR.AddReg]
HKR,,DevLoader,,*NTKERN
;HKR,,NTMPDriver,,"wdmstub.sys,USBSTOR.SYS"
HKR,,NTMPDriver,,USBSTOR.SYS

[USBSTOR_CBI.AddReg]
HKR,,DriverFlags,0x00010001,0x00000002

[USBSTOR_CB.AddReg]
HKR,,DriverFlags,0x00010001,0x00000003

[USBSTOR_BULK.AddReg]
HKR,,DriverFlags,0x00010001,0x00000001

[QV2KUX.HW]
Addreg=QV2KUX_Filter_Reg

[USBSTOR_CBI.HW]
AddReg=USBSTOR.HW.AddReg

[USBSTOR_CBI_U2A.HW]
AddReg=USBSTOR.HW.AddReg,USBSTOR_U2A.HW.AddReg

[USBSTOR_CBI_NR.HW]
AddReg=USBSTOR.HW.AddReg,USBSTOR_NR.AddReg
DelReg=USBSTOR_CBI_NR.DelReg

[USBSTOR_CB.HW]
AddReg=USBSTOR.HW.AddReg

[USBSTOR_BULK.HW]
AddReg=USBSTOR.HW.AddReg

[USBSTOR_BULK_AUTH.HW]
AddReg=USBSTOR.HW.AddReg, USBSTOR_AUTH.HW.AddReg

[QV2KUX_Filter_Reg]
HKR,,"LowerFilters",0x00010000,"QV2KUX.SYS"

[USBSTOR.HW.AddReg]
HKR,,upperfilters,0,"USBNTMAP.SYS"

[USBSTOR_AUTH.HW.AddReg]
HKR,,lowerfilters,0,"USBAUTH.SYS"

[USBSTOR_U2A.HW.AddReg]
HKR,,"LowerFilters",0x00010000,"USBU2A.SYS"
HKR,,"SampleFilterParam",0x00010001,512

[USBSTOR_CBI_NR.DelReg]
HKR,,"LowerFilters"

[USBSTOR_NR.AddReg]
HKR,,NonRemovable,0x00010001,0x00000001

[USBSTOR.AddService]
DisplayName    = %USBSTOR.SvcDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\USBSTOR.SYS

;[USBSTOR.CopyList]
; USBSTOR.SYS

;[USBNTMAP.CopyList]
; USBNTMAP.SYS

;[USBAUTH.CopyList]
; USBAUTH.SYS

;[USBU2A.CopyList]
; USBU2A.SYS

