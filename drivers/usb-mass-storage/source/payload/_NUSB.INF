;Maximus Decim native USB-flashdisk for Windows 98 3.6 - universal edition (localized on the target PC)
;Based on NUSB 3.6 Enu (Maximus Decim). Strings below are replaced from the language pack by the setup.

[Version]
AdvancedINF = 2.5, %AdvPackWarn% 
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles=W98Upd.Copy.qfe,W98Upd.Copy.Sys32,W98Upd.Copy.VMM,W98Upd.Copy.Sys,W98Upd.Copy.Sub,W98Upd.Copy.Hlp,W98Upd.Copy.inf,Win98.Copy.cab
AddReg=W98Upd.AddReg

[DestinationDirs]
W98Upd.Copy.qfe		= 10
W98Upd.Copy.Sys32	= 10,SYSTEM32\DRIVERS
W98Upd.Copy.VMM		= 22
W98Upd.Copy.Sys		= 11
W98Upd.Copy.Sub		= 12
W98Upd.Copy.Hlp		= 18
W98Upd.Copy.inf		= 17
Win98.Copy.cab		= 10,Options\Cabs

[W98Upd.Copy.qfe]
explorer.exe,,,4

[W98Upd.Copy.Sys32]
