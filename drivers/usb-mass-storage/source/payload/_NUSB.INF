USBHUB.SYS,,,32  
USBCCGP.SYS,,,32
USB.INF,,,32
QV2KUX.SYS,,,32

[W98Upd.AddReg]
;msinfo32
HKLM,"Software\Microsoft\Active Setup\Installed Components\%GUID%",,,"%UpdName%"
HKLM,"Software\Microsoft\Active Setup\Installed Components\%GUID%","IsInstalled",0x10001,01,00,00,00
HKLM,"Software\Microsoft\Active Setup\Installed Components\%GUID%","Locale",,"%LANG%"
HKLM,"Software\Microsoft\Active Setup\Installed Components\%GUID%","Version",,"%VERSION%"

;usb.addreg
HKLM,Software\Microsoft\Windows\CurrentVersion\Run,SystemTray,,"SysTray.Exe"
; Silent Driver Install
HKLM,System\CurrentControlSet\Services\Class\USB,"SilentInstall",,"1"
HKLM,System\CurrentControlSet\Services\Class\USB,"SilentInstallNotify",,"1"

;qfecheck
HKLM,%UpdateKey%\%SPKey%\%LocaleID%%UpdID%\,,,"%UpdName%"
HKLM,%UpdateKey%\%SPKey%\%LocaleID%%UpdID%,%10%\SYSTEM32\DRIVERS\1394BUS.SYS,,"4.10.0.2226"
HKLM,%UpdateKey%\%SPKey%\%LocaleID%%UpdID%,%10%\SYSTEM32\DRIVERS\OHCI1394.SYS,,"4.10.0.2228"
HKLM,%UpdateKey%\%SPKey%\%LocaleID%%UpdID%,%10%\SYSTEM32\DRIVERS\SBP2PORT.SYS,,"4.10.0.2227"
HKLM,%UpdateKey%\%SPKey%\%LocaleID%%UpdID%,%10%\SYSTEM32\DRIVERS\NTMAP.SYS,,"4.10.0.2227"
HKLM,%UpdateKey%\%SPKey%\%LocaleID%%UpdID%,%22%\ios.vxd,,"4.10.0.2225"
HKLM,%UpdateKey%\%SPKey%\%LocaleID%%UpdID%,%11%\hotplug.dll,,"4.10.0.2224"
HKLM,%UpdateKey%\%SPKey%\%LocaleID%%UpdID%,%11%\systray.exe,,"4.10.0.2224"
HKLM,%UpdateKey%\%SPKey%\%LocaleID%%UpdID%,%11%\user.exe,,"4.10.0.2231"
HKLM,%UpdateKey%\%SPKey%\%LocaleID%%UpdID%,%11%\user32.dll,,"4.10.0.2231"
HKLM,%UpdateKey%\%SPKey%\%LocaleID%%UpdID%,%12%\ntmaphlp.pdr,,"4.10.0.2223"
HKLM,%UpdateKey%\%SPKey%\%LocaleID%%UpdID%,%12%\disktsd.vxd,,"4.90.0.3000"

;wdmstub
;HKLM,System\CurrentControlSet\Services\Class\System\0000,NTMPDriver,,"update.sys,wdmstub.sys"

;for uninstall usb2.0
HKLM,Software\Microsoft\Windows\CurrentVersion\Uninstall\USB20U,DisplayName,,%USB20UName%
HKLM,Software\Microsoft\Windows\CurrentVersion\Uninstall\USB20U,UninstallString,,"RUNDLL32.EXE %11%\ADVPACK.DLL,LaunchINFSection %17%\_USB2UN.INF,UNINSTALL"

[Strings]
;Non-localizable
GUID                    = "{10e93000-e548-11d3-9741-00500483cae0}"
VERSION                 = "4.10.0.2222"
UpdID			= "242975"
UpdateKey               = "Software\Microsoft\Windows\CurrentVersion\Setup\Updates"
SPKey         		= "W98.SE"

;Localizable strings
Lang			= "EN"
LocaleID		= "UPD"
UpdName			= "Windows 98 Second Edition Q242975 Update"
AdvPackWarn		= "You need a newer version of advpack.dll."
SrcDiskName		= "Native USB for Windows 98 3.6 (incl. Q242975)"
USB20UName		= "Remove Unofficial Universal USB 2.0 Stack (NUSB)"

[SourceDisksNames]
55="%SrcDiskName% Update","",0

