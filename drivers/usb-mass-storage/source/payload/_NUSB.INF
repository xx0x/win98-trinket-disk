ios.vxd,,,4

[W98Upd.Copy.Sys]
hotplug.dll,,,4
systray.exe,,,4
user.exe,,,4
user32.dll,,,32

[W98Upd.Copy.Sub]
ntmaphlp.pdr,,,32
DISKTSD.VXD,,,32
usbmphlp.pdr,,,32
cdvsd.vxd,,,32

[W98Upd.Copy.Hlp]
hardware.hlp

[W98Upd.Copy.inf]
1394.INF
ntmap.inf
usbstor.inf
usbntmap.inf,,,32
NODRIVER.INF
USB2.INF,,,32
USB.INF,,,32
_USB2UN.INF,,,32

[Win98.Copy.cab]
1394BUS.SYS,,,32
OHCI1394.SYS,,,32
SBP2PORT.SYS,,,32
NTMAP.SYS,,,32
ios.vxd,,,4
hotplug.dll,,,4
systray.exe,,,4
hardware.hlp,,,32
1394.INF,,,32
ntmap.inf,,,32
ntmaphlp.pdr,,,32
user.exe,,,4
user32.dll,,,32
DISKTSD.VXD,,,32
usbauth.sys,,,32
usbmphlp.pdr,,,32
usbntmap.sys,,,32
usbstor.sys,,,4
usbstor.inf,,,32
usbntmap.inf,,,32
;usbu2a.sys,,,32
NODRIVER.INF,,,32
explorer.exe,,,4
USB2.INF,,,32
USBEHCI.SYS,,,32
USBHUB20.SYS,,,32
USBPORT.SYS,,,32
wdmstub.sys,,,32
cdvsd.vxd,,,32
